# Variables for docker-compose.qlane.yml. Set each on the Qlane test target; the stack
# refuses to start while any of them is empty.

# The password of the first QA account (username qa-admin, qa-admin@example.com), created on first boot.
QA_ADMIN_PASSWORD=
# The password of the second QA account (username qa-user, qa-user@example.com), created on first boot.
QA_USER_PASSWORD=
